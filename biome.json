{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"includes": ["**", "!!**/dist", "!!**/coverage"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded",
			"arrowParentheses": "asNeeded"
		}
	},
	"linter": {
		"enabled": true,
		"domains": {
			"project": "recommended",
			"test": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error",
				"noUnusedFunctionParameters": "error",
				"noUndeclaredDependencies": {
					"level": "error",
					"options": {
						"devDependencies": ["**/__tests__/**", "**/{tsdown,vitest}.config.ts"]
					}
				}
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noImportCycles": "error",
				"noConsole": "error",
				"noSkippedTests": "error"
			},
			"style": {
				"useImportType": "error",
				"useExportType": "error",
				"noNonNullAssertion": "error",
				"noEnum": "error",
				"noCommonJs": "error",
				"noParameterAssign": "error",
				"noInferrableTypes": "error",
				"useAsConstAssertion": "error"
			},
			"performance": {
				"noReExportAll": "error"
			}
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["scripts/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		}
	]
}
